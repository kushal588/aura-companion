.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
*.jks
keystore.properties

# local runtime data (app data dirs are outside the source tree; kept here for dev safety)
.aura-data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
exports/
logs/

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
